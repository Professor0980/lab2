<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LAB2_LEPEKHA_ANTON.ViewModels"
             x:Class="LAB2_LEPEKHA_ANTON.MainPage"
             Title="Особистий кабінет студента">

    <ContentPage.BindingContext>
        <vm:StudentViewModel />
    </ContentPage.BindingContext>

    <CollectionView ItemsSource="{Binding Students}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Grid Padding="15" ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="{Binding FullName}" FontAttributes="Bold" FontSize="16"/>
                        <Label Text="{Binding Group}" TextColor="Gray"/>
                        <Label Text="{Binding AverageScore, StringFormat='Середній бал: {0}'}" TextColor="DarkBlue"/>
                    </VerticalStackLayout>

                    <Button Grid.Column="1" 
                            Text="Детальніше" 
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StudentViewModel}}, Path=OpenDetailsCommand}" 
                            CommandParameter="{Binding .}" 
                            VerticalOptions="Center"/>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>